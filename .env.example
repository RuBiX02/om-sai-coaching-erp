# ------------------------------------------------------------------
# Om Sai Coaching ERP - example environment configuration
# Copy to .env (never commit .env) or export these variables before
# running the application.
#
# IMPORTANT: the defaults shown here are for local development only.
# Never use them in production. Production passwords must be supplied
# through a secret manager or secure environment.
# ------------------------------------------------------------------

# Database (PostgreSQL). Flyway migrations run automatically at startup.
DB_URL=jdbc:postgresql://127.0.0.1:5433/omsai
DB_USERNAME=tojo
DB_PASSWORD=omsai_dev

# HTTP
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false   # set to true when serving over HTTPS

# First administrator bootstrap (run once on a fresh database).
# See "First administrator account" in README.md.
APP_BOOTSTRAP_ADMIN=false
APP_ADMIN_NAME=Om Sai Administrator
APP_ADMIN_EMAIL=admin@omsai.local
APP_ADMIN_PASSWORD=

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
