# Om Sai Coaching ERP — environment template
#
# Copy this file to a file your tooling loads (or export the values in
# your shell profile). Real `.env` files are never committed
# (.gitignore excludes .env and .env.*); only this template belongs in
# the repository, with placeholder values only.
#
# NOTE: no file in this repository stores a real password. Every
# credential below must be chosen by the operator.

# ---- application database ------------------------------------------
DB_URL=jdbc:postgresql://127.0.0.1:5433/omsai
DB_USERNAME=<your-postgres-user>
DB_PASSWORD=<your-postgres-password>
SERVER_PORT=8080

# ---- first administrator (one-time, opt-in bootstrap) ---------------
APP_BOOTSTRAP_ADMIN=false
APP_ADMIN_NAME=<display-name>
APP_ADMIN_EMAIL=<sign-in-email>
APP_ADMIN_PASSWORD=<at-least-12-characters>

# ---- login rate limiting (sign-in hardening) ------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- integration tests (disposable omsai_test database) -------------
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5433/omsai_test
TEST_DB_USERNAME=<your-postgres-user>
TEST_DB_PASSWORD=<your-postgres-password>

# ---- real-browser tests (disposable omsai_browser database) ---------
BROWSER_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5433/omsai_browser
BROWSER_TEST_DB_USERNAME=<your-postgres-user>
BROWSER_TEST_DB_PASSWORD=<your-postgres-password>

# ---- end-to-end smoke script (scripts/e2e-smoke.sh) -----------------
OMSAI_DB_PASSWORD=<your-postgres-password>
OMSAI_ADMIN_EMAIL=admin@omsai.local
OMSAI_ADMIN_PASS=<the-bootstrapped-admin-password>

# ---- demo instance (disposable omsai_demo database) -----------------
DEMO_DB_PASSWORD=<your-postgres-password>
APP_ADMIN_EMAIL=<demo-admin-email>
APP_ADMIN_PASSWORD=<at-least-12-characters>
